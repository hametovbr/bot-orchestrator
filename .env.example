# Copy to .env next to docker-compose.yml and fill in the empty values.
# Generate random values with:  openssl rand -hex 32

# --- Shared by several services ---

# Shared secret between bot-orchestrator and bot-runner.
RUNNER_SECRET=

# --- bot-orchestrator ---

# Password for the web UI.
ADMIN_PASSWORD=

# Encrypts bot tokens and secrets and signs sessions. Changing it makes stored
# tokens and secrets unreadable.
SECRET_KEY=

# Port of the web UI on the host. Bind it to a LAN or VPN address, not the internet.
ORCHESTRATOR_BIND=127.0.0.1:8000

# How long to keep the update log, in days.
UPDATE_RETENTION_DAYS=14

# Handlers running at the same time for one bot.
BOT_CONCURRENCY=4

# Set to true when the UI is served over HTTPS (marks the session cookie Secure).
SECURE_COOKIES=false

# Public address of the UI, used for links in notifications (optional).
PUBLIC_URL=

# Timezone for schedules and times in the UI (IANA name).
TZ=UTC

# Background tasks running at the same time, across all bots.
TASK_CONCURRENCY=2

# Delete files the Bot API server downloaded after this many hours (0 keeps them).
CACHE_RETENTION_HOURS=24

# Notify when the disk with bot files is fuller than this, in percent.
DISK_WARNING_PERCENT=90

# --- telegram-bot-api (values from https://my.telegram.org) ---

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- bot-runner ---

# Hard time limit for one handler call, in seconds.
HANDLER_TIMEOUT=60

# Hard time limit for one background task, in seconds.
TASK_TIMEOUT=3600

# Background tasks the runner executes at the same time.
MAX_CONCURRENT_TASKS=2

# Address-space limit for one handler process, in MB (0 disables the limit).
HANDLER_MEMORY_MB=1024

# Maximum number of handler processes running at the same time.
MAX_CONCURRENT_RUNS=8

# --- Advanced: defaults match docker-compose.yml ---
# BOT_API_URL=http://telegram-bot-api:8081
# RUNNER_URL=http://bot-runner:8000
# CLOUD_API_URL=https://api.telegram.org
# DATABASE_PATH=/data/orchestrator.db
# FILES_ROOT=/files
# RUNNER_REQUEST_TIMEOUT=180
# TASK_REQUEST_TIMEOUT=7200
# BOT_API_DATA_DIR=/var/lib/telegram-bot-api
# POLLING_TIMEOUT=25

# Environment variables for handlers are not set here: add BOTENV_<NAME>=value to the
# bot-runner service in docker-compose.yml. Handlers see it as <NAME>=value.
